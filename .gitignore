# =============================================================================
# .gitignore
# Galaxy Telecom Multi-Agent Support System
# -----------------------------------------------------------------------------
# Files and folders excluded from version control.
# =============================================================================

# Virtual environment
venv/

# Environment variables — never commit API keys
.env

# Python cache files
__pycache__/
*.pyc
*.pyo

# SQLite audit database
audit/*.db

# VS Code settings
.vscode/

# OS files
.DS_Store
Thumbs.db