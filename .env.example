# =============================================================================
# .env.example
# Galaxy Telecom Multi-Agent Support System
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in your actual API keys.
# Never commit .env to GitHub — it is listed in .gitignore.
# =============================================================================

# Anthropic API key — used by all LLM calls in the agent graph
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangFuse observability — get these from cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Qdrant cloud — used by the KB agent for product knowledge retrieval
QDRANT_URL=your_qdrant_cluster_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=galaxy-telecom-products

# Slack webhook — used by the escalation handler to alert human agents
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# LLM Model Configuration — tiered by task complexity
CLAUDE_MODEL_STANDARD=claude-haiku-4-5-20251001
CLAUDE_MODEL_ADVANCED=claude-sonnet-4-6

# Temperature Configuration — tuned per agent role
CLAUDE_TEMPERATURE_PRECISE=0
CLAUDE_TEMPERATURE_BALANCED=0.3
CLAUDE_TEMPERATURE_CREATIVE=0.4
